{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octoboard",
  "version": "0.1.0",
  "identifier": "dev.octoboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/octoboardd"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  }
}
