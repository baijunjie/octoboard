{
  "name": "octoboard",
  "private": true,
  "version": "0.1.0",
  "description": "Octoboard desktop application: a Tauri 2 shell around a React/TypeScript UI that talks to octoboardd over WebSocket only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build:tauri": "npm run build:daemon && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
