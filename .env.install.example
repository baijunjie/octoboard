# Copy to .env.install.local (gitignored). Only build:install reads this file.
# Use an absolute directory path. Spaces and matching quotes are supported; no ~ or $VAR expansion.
OCTOBOARD_INSTALL_DIR=/Users/you/Applications

# A certificate already installed in your keychain; find it with:
# security find-identity -v -p codesigning
# Keep the same identity across updates to help macOS retain privacy grants.
OCTOBOARD_INSTALL_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
