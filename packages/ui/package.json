{
  "name": "@octoboard/ui",
  "private": true,
  "version": "0.1.0",
  "description": "Octoboard UI: a HeroUI React application that talks to octoboardd over WebSocket only, runs in a plain browser, and reaches native capabilities only through a platform adapter.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gallery": "vite --port 5175 --open /gallery.html",
    "gallery:sweep": "node scripts/gallery-sweep.mjs",
    "bench:wkwebview": "node scripts/wkbench/run.mjs",
    "build": "tsc --noEmit && vitest run src/i18n && vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@pierre/diffs": "1.5.2",
    "@pierre/theming": "1.0.1",
    "@shikijs/themes": "4.5.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "4.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
