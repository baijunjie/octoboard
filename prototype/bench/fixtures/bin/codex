#!/bin/sh
# Bench-only stand-in for the real `codex` CLI.
#
# PROTOCOL.md's start_session only launches real agent binaries (claude/grok/codex) — there is
# no "plain shell" session type, which T2/T3 need (see prototype/README.md: measure the
# daemon/PTY path itself, not an agent TUI's own latency). This script is how the bench harness
# gets one without touching prototype/daemon/ or any real agent config: common.mjs starts the
# daemon with SHELL=/bin/sh and this directory first on PATH, and `startDaemon` there asserts
# this shim actually wins the PATH lookup before any session starts — never rely on this comment
# alone to keep a real `codex`/`claude`/`grok` binary on some other machine's PATH from shadowing
# it.
#
# daemon/src/adapter/codex.rs's degraded-mode build_args injects nothing but the positional task
# string, so $1 here is exactly whatever the bench script passed as `task` in start_session.
# That doubles as this fixture's own tiny control protocol — see each bench script for which
# mode it asks for.
case "$1" in
  cat)
    # T2 latency/throughput: a session that only ever echoes what it is sent. Put the PTY in raw
    # mode first: in the default canonical mode, the kernel line discipline withholds input from
    # `cat` until a newline (or ~4 KiB) accumulates, which starves a throughput test that floods
    # unbroken binary data; `-echo` also means the only echo left is `cat`'s own, not a kernel
    # duplicate on top of it. The "READY" line lets the bench script wait for `stty` to have
    # actually taken effect before sending real payload: a chunk sent while the PTY is still in
    # canonical mode can get stuck in the line discipline's input queue forever (no newline to
    # flush it), which would look exactly like the daemon losing bytes but is really this race.
    stty raw -echo
    printf 'READY\n'
    exec cat
    ;;
  counter)
    # T3 replay exactness: a free-running, independently verifiable byte stream — a
    # monotonically increasing counter, one per line, with no dependency on what the client
    # sends. Throttled to roughly 30K lines/sec (a `sleep` every 200 iterations, amortizing
    # that command's own fork+exec cost): unthrottled, plain shell arithmetic and `printf` push
    # past 200K lines/sec on this machine, which fills the daemon's ring buffer (state.rs
    # RING_CAPACITY) in well under the time replay.mjs needs just to disconnect and reconnect, so
    # its "short detach, no overflow" case would overflow anyway without this throttle. At this
    # rate a sub-second detach stays an order of magnitude under capacity, and a several-second
    # one comfortably exceeds it, so the two bench cases actually exercise different behavior.
    exec /bin/sh -c 'i=0; while :; do i=$((i + 1)); printf "LINE %d\n" "$i"; if [ $((i % 200)) -eq 0 ]; then sleep 0.001; fi; done'
    ;;
  blast:sustained)
    # T2 output throughput, paced variant: a free-running, high-volume byte stream with no
    # dependency on what the client sends — like "counter", but sized to find a bytes/sec
    # figure rather than to test replay exactness. Paced (64 KiB per `dd`, a `sleep` every 4
    # iterations, amortizing dd's own fork+exec cost the way "counter" amortizes printf's) to
    # roughly 12 MiB/s as measured: comfortably below the ~490 MiB/s this machine's loopback path can
    # sustain for large frames (see throughput.mjs), so output_throughput.mjs can compare
    # read-buffer sizes against each other while staying inside the broadcast channel's capacity
    # (state.rs TERM_BROADCAST_CAPACITY) at every size, instead of every size tripping its
    # overrun disconnect the way an unpaced flood always does.
    exec /bin/sh -c 'i=0; while :; do dd if=/dev/zero bs=65536 count=1 2>/dev/null; i=$((i + 1)); if [ $((i % 4)) -eq 0 ]; then sleep 0.008; fi; done'
    ;;
  blast:flood)
    # T2 output throughput, unpaced variant: the output-direction counterpart of
    # throughput.mjs's input "flood" — a single long-running `dd`, writing as fast as the
    # kernel PTY buffer and the reader thread downstream of it allow, with no per-iteration
    # fork+exec overhead to blunt the rate. Exists to check whether the daemon's read-buffer
    # size changes the already-documented overrun-and-disconnect outcome (state.rs
    # TERM_BROADCAST_CAPACITY), which past measurement only ever exercised at the fixed 8 KiB
    # default.
    exec dd if=/dev/zero bs=1048576
    ;;
  *)
    # Fallback: an ordinary interactive shell, for poking at the fixture by hand.
    exec /bin/sh -i
    ;;
esac
