{
  "name": "octoboard-workspace",
  "private": true,
  "description": "Workspace root for the Octoboard monorepo: the common commands run across every package that has content.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "install:macos": "pnpm --filter @octoboard/desktop install:macos",
    "test:rust": "node scripts/test-rust.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format": "eslint . --fix --fix-type layout && cargo fmt --all",
    "format:check": "pnpm lint && cargo fmt --all -- --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  }
}
