{
  "name": "octoboard-workspace",
  "private": true,
  "description": "Repository-wide verification, formatting, Rust workspace checks and maintenance for Octoboard.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "format": "eslint . --fix --fix-type layout && cargo fmt --all",
    "format:staged": "node scripts/hooks/format-staged.mjs",
    "clippy:rust": "node scripts/cargo.mjs clippy",
    "test:rust": "node scripts/cargo.mjs test",
    "identity:sync": "node scripts/sync-identity.mjs",
    "identity:check": "node scripts/sync-identity.mjs --check",
    "hooks:install": "sh .githooks/install.sh",
    "prepare": "sh .githooks/auto-install.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  }
}
