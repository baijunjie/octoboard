; Tauri's own installer strings in Thai, for which Tauri ships no translation
; (`bundle.windows.nsis.customLanguageFiles`). The keys are those of Tauri's English file.
LangString addOrReinstall ${LANG_THAI} "เพิ่ม/ติดตั้งคอมโพเนนต์ใหม่"
LangString alreadyInstalled ${LANG_THAI} "ติดตั้งไว้แล้ว"
LangString alreadyInstalledLong ${LANG_THAI} "${PRODUCTNAME} ${VERSION} ติดตั้งไว้แล้ว เลือกการดำเนินการที่ต้องการ แล้วคลิก ต่อไป เพื่อดำเนินการต่อ"
LangString appRunning ${LANG_THAI} "${PRODUCTNAME} กำลังทำงานอยู่ ปิดแอปก่อนแล้วลองอีกครั้ง"
LangString appRunningOkKill ${LANG_THAI} "${PRODUCTNAME} กำลังทำงานอยู่$\nคลิก ตกลง เพื่อปิดแอป"
LangString chooseMaintenanceOption ${LANG_THAI} "เลือกการบำรุงรักษาที่ต้องการทำ"
LangString choowHowToInstall ${LANG_THAI} "เลือกวิธีติดตั้ง ${PRODUCTNAME}"
LangString createDesktop ${LANG_THAI} "สร้างทางลัดบนเดสก์ท็อป"
LangString dontUninstall ${LANG_THAI} "ไม่ถอนการติดตั้ง"
LangString dontUninstallDowngrade ${LANG_THAI} "ไม่ถอนการติดตั้ง (ตัวติดตั้งนี้ปิดการลดเวอร์ชันโดยไม่ถอนการติดตั้งไว้)"
LangString failedToKillApp ${LANG_THAI} "ปิด ${PRODUCTNAME} ไม่ได้ ปิดแอปก่อนแล้วลองอีกครั้ง"
LangString installingWebview2 ${LANG_THAI} "กำลังติดตั้ง WebView2…"
LangString newerVersionInstalled ${LANG_THAI} "มี ${PRODUCTNAME} เวอร์ชันที่ใหม่กว่าติดตั้งไว้แล้ว ไม่แนะนำให้ติดตั้งเวอร์ชันที่เก่ากว่า หากต้องการติดตั้งเวอร์ชันเก่านี้จริงๆ ควรถอนการติดตั้งเวอร์ชันปัจจุบันก่อน เลือกการดำเนินการที่ต้องการ แล้วคลิก ต่อไป เพื่อดำเนินการต่อ"
LangString older ${LANG_THAI} "ที่เก่ากว่า"
LangString olderOrUnknownVersionInstalled ${LANG_THAI} "มี ${PRODUCTNAME} เวอร์ชัน$R4ติดตั้งอยู่ในระบบ แนะนำให้ถอนการติดตั้งเวอร์ชันปัจจุบันก่อนติดตั้ง เลือกการดำเนินการที่ต้องการ แล้วคลิก ต่อไป เพื่อดำเนินการต่อ"
LangString silentDowngrades ${LANG_THAI} "ตัวติดตั้งนี้ปิดการลดเวอร์ชันไว้ จึงติดตั้งแบบเงียบต่อไม่ได้ ให้ใช้ตัวติดตั้งแบบกราฟิกแทน$\n"
LangString unableToUninstall ${LANG_THAI} "ถอนการติดตั้งไม่ได้"
LangString uninstallApp ${LANG_THAI} "ถอนการติดตั้ง ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_THAI} "ถอนการติดตั้งก่อนติดตั้ง"
LangString unknown ${LANG_THAI} "ที่ไม่รู้จัก"
LangString webview2AbortError ${LANG_THAI} "ติดตั้ง WebView2 ไม่ได้ แอปจะทำงานไม่ได้หากไม่มี WebView2 ลองเริ่มตัวติดตั้งใหม่"
LangString webview2DownloadError ${LANG_THAI} "ข้อผิดพลาด: ดาวน์โหลด WebView2 ไม่สำเร็จ - $0"
LangString webview2DownloadSuccess ${LANG_THAI} "ดาวน์โหลดบูตสแตรปเปอร์ WebView2 แล้ว"
LangString webview2Downloading ${LANG_THAI} "กำลังดาวน์โหลดบูตสแตรปเปอร์ WebView2…"
LangString webview2InstallError ${LANG_THAI} "ข้อผิดพลาด: ติดตั้ง WebView2 ไม่สำเร็จ รหัสการออก $1"
LangString webview2InstallSuccess ${LANG_THAI} "ติดตั้ง WebView2 แล้ว"
LangString deleteAppData ${LANG_THAI} "ลบข้อมูลของแอป"
