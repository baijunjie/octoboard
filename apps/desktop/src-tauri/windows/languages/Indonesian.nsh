; Tauri's own installer strings in Indonesian, for which Tauri ships no translation
; (`bundle.windows.nsis.customLanguageFiles`). The keys are those of Tauri's English file.
LangString addOrReinstall ${LANG_INDONESIAN} "Tambah/Instal ulang komponen"
LangString alreadyInstalled ${LANG_INDONESIAN} "Sudah terinstal"
LangString alreadyInstalledLong ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terinstal. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk melanjutkan."
LangString appRunning ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan! Tutup dulu, lalu coba lagi."
LangString appRunningOkKill ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan!$\nKlik OK untuk menghentikannya"
LangString chooseMaintenanceOption ${LANG_INDONESIAN} "Pilih tindakan pemeliharaan yang akan dilakukan."
LangString choowHowToInstall ${LANG_INDONESIAN} "Pilih cara menginstal ${PRODUCTNAME}."
LangString createDesktop ${LANG_INDONESIAN} "Buat pintasan desktop"
LangString dontUninstall ${LANG_INDONESIAN} "Jangan copot"
LangString dontUninstallDowngrade ${LANG_INDONESIAN} "Jangan copot (penurunan versi tanpa mencopot dinonaktifkan untuk penginstal ini)"
LangString failedToKillApp ${LANG_INDONESIAN} "Tidak dapat menghentikan ${PRODUCTNAME}. Tutup dulu, lalu coba lagi"
LangString installingWebview2 ${LANG_INDONESIAN} "Menginstal WebView2…"
LangString newerVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang lebih baru sudah terinstal! Menginstal versi yang lebih lama tidak disarankan. Jika Anda benar-benar ingin menginstal versi lama ini, sebaiknya copot dulu versi yang sekarang. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk melanjutkan."
LangString older ${LANG_INDONESIAN} "lebih lama"
LangString olderOrUnknownVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang $R4 terinstal di sistem Anda. Sebaiknya copot versi yang sekarang sebelum menginstal. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk melanjutkan."
LangString silentDowngrades ${LANG_INDONESIAN} "Penurunan versi dinonaktifkan untuk penginstal ini, jadi penginstal senyap tidak dapat melanjutkan. Gunakan penginstal dengan antarmuka grafis.$\n"
LangString unableToUninstall ${LANG_INDONESIAN} "Tidak dapat mencopot!"
LangString uninstallApp ${LANG_INDONESIAN} "Copot ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_INDONESIAN} "Copot sebelum menginstal"
LangString unknown ${LANG_INDONESIAN} "tidak diketahui"
LangString webview2AbortError ${LANG_INDONESIAN} "Tidak dapat menginstal WebView2! Aplikasi tidak dapat berjalan tanpanya. Coba mulai ulang penginstal."
LangString webview2DownloadError ${LANG_INDONESIAN} "Kesalahan: Gagal mengunduh WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_INDONESIAN} "Bootstrapper WebView2 berhasil diunduh"
LangString webview2Downloading ${LANG_INDONESIAN} "Mengunduh bootstrapper WebView2…"
LangString webview2InstallError ${LANG_INDONESIAN} "Kesalahan: Gagal menginstal WebView2 dengan kode keluar $1"
LangString webview2InstallSuccess ${LANG_INDONESIAN} "WebView2 berhasil diinstal"
LangString deleteAppData ${LANG_INDONESIAN} "Hapus data aplikasi"
