{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octoboard",
  "version": "../package.json",
  "identifier": "dev.octoboard.desktop",
  "build": {
    "beforeDevCommand": "pnpm native:generate && pnpm --filter @octoboard/ui dev",
    "beforeBuildCommand": "pnpm native:generate && pnpm build:tauri",
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQjVFRjg3MjI4QzMwOTUKUldTVk1Jd2loKysxZ1g4bFlIanRXdFlJNkZ6UnhnY1FWa0tMSFRxTGdOdzBsejI3dG91T0s4R0IK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/AppIcon.icon"
    ],
    "externalBin": ["binaries/octoboardd"],
    "resources": {
      "generated-localizations/ar.lproj/InfoPlist.strings": "ar.lproj/InfoPlist.strings",
      "generated-localizations/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings",
      "generated-localizations/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "generated-localizations/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "generated-localizations/fr.lproj/InfoPlist.strings": "fr.lproj/InfoPlist.strings",
      "generated-localizations/hi.lproj/InfoPlist.strings": "hi.lproj/InfoPlist.strings",
      "generated-localizations/id.lproj/InfoPlist.strings": "id.lproj/InfoPlist.strings",
      "generated-localizations/it.lproj/InfoPlist.strings": "it.lproj/InfoPlist.strings",
      "generated-localizations/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings",
      "generated-localizations/ko.lproj/InfoPlist.strings": "ko.lproj/InfoPlist.strings",
      "generated-localizations/pt.lproj/InfoPlist.strings": "pt.lproj/InfoPlist.strings",
      "generated-localizations/ru.lproj/InfoPlist.strings": "ru.lproj/InfoPlist.strings",
      "generated-localizations/th.lproj/InfoPlist.strings": "th.lproj/InfoPlist.strings",
      "generated-localizations/tr.lproj/InfoPlist.strings": "tr.lproj/InfoPlist.strings",
      "generated-localizations/vi.lproj/InfoPlist.strings": "vi.lproj/InfoPlist.strings",
      "generated-localizations/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings",
      "generated-localizations/zh-Hant.lproj/InfoPlist.strings": "zh-Hant.lproj/InfoPlist.strings"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "images/dmg-background-pixel.png",
        "windowSize": { "width": 806, "height": 488 },
        "appPosition": { "x": 226, "y": 199 },
        "applicationFolderPosition": { "x": 581, "y": 199 }
      }
    }
  }
}
