{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octoboard",
  "version": "0.1.0",
  "identifier": "dev.octoboard.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @octoboard/ui dev",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFREMzN0MzMDI3OUQ4MUYKUldRZjJIa0N3emZjcmxidjRwaHQ0QlJNV01KWGRwMUtUY3J2M2RGekpTbTZaYVluRVVTTWMvQm8K"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/AppIcon.icon",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/octoboardd"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  }
}
