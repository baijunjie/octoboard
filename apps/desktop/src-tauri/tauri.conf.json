{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octoboard",
  "version": "../package.json",
  "identifier": "dev.octoboard.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @octoboard/ui dev",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQjVFRjg3MjI4QzMwOTUKUldTVk1Jd2loKysxZ1g4bFlIanRXdFlJNkZ6UnhnY1FWa0tMSFRxTGdOdzBsejI3dG91T0s4R0IK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/AppIcon.icon"
    ],
    "externalBin": ["binaries/octoboardd"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "background": "images/dmg-background-pixel.png",
        "windowSize": { "width": 806, "height": 488 },
        "appPosition": { "x": 226, "y": 199 },
        "applicationFolderPosition": { "x": 581, "y": 199 }
      }
    }
  }
}
