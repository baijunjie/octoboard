{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "node ../../scripts/fetch-conpty.mjs --installer && pnpm --filter @octoboard/ui dev",
    "beforeBuildCommand": "node ../../scripts/fetch-conpty.mjs --installer && pnpm build:tauri"
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../target/conpty-bundle/conpty.dll": "conpty.dll",
      "../../../target/conpty-bundle/x64/OpenConsole.exe": "x64/OpenConsole.exe",
      "../../../target/conpty-bundle/arm64/OpenConsole.exe": "arm64/OpenConsole.exe",
      "licenses/windows-terminal/LICENSE": "licenses/windows-terminal/LICENSE",
      "licenses/windows-terminal/NOTICE.md": "licenses/windows-terminal/NOTICE.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
