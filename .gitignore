# OS
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Dependencies
node_modules/
.pnpm-store/

# Build output
__pycache__/
*.py[cod]
dist/
build/
out/
coverage/
# The one Cargo build directory of the root workspace
/target/

# Scratch of `pnpm bench:wkwebview` in packages/ui: throwaway HOME, daemon build, bundles, host binary
/packages/ui/.bench/

# Env & logs: `.env`, `.env.secret.example` and `.env.local.example` are committed; credentials live in `.env.secret`,
# machine-local values in `.env.local`
.env.secret*
!.env.secret.example
.env*.local
*.log

# Claude Code local
.claude/settings.local.json

# Review-only gallery scenarios and the record of the preview serving them, per checkout
/packages/ui/src/gallery/preview/

# The third-party licenses About lists, written by `packages/ui/scripts/generate-licenses.mjs` (the committed
# `licenses.fallback.json` stands in until it has been run)
/packages/ui/src/about/licenses.generated.json

# Git worktrees
.worktrees/
