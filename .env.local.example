# Copy to .env.local (gitignored) for machine-local values. A linked worktree takes the installation directory
# and the slot count from the main working copy's .env.local; the dev ports only from its own.
# A real environment variable always wins over a value here. Use absolute paths; spaces and matching
# quotes are supported; no ~ or $VAR expansion.

# The installation directory for `pnpm install:macos`, which reads nothing else from this file.
OCTOBOARD_INSTALL_DIR=/Users/you/Applications

# How many heavy steps (UI tests, Rust tests, gallery page loads) run at once across every worktree
# (`scripts/verify/lock.mjs`); unset, it follows the machine's cores and memory.
#OCTOBOARD_VERIFY_SLOTS=2

# Development only: the port and key a hand-started daemon bound and made (printed on its first stdout
# line, `octoboardd listening on 127.0.0.1:<port> with key <key>`; the port is also kept in
# $TMPDIR/octoboardd.port, the key is not kept anywhere). They are for `pnpm dev`, see packages/ui/README.md's
# "Pointing it at a daemon". The key changes at every daemon start, so passing it as `?key=` in the page's
# URL is usually less work than keeping it here.

# Makes the dev server proxy `/ws` to the daemon, so the plain URL works.
#OCTOBOARD_DAEMON_PORT=

# Points the UI at the daemon directly, without the proxy.
#VITE_DAEMON_PORT=

# The key the daemon requires of every connection, with the proxy or without it.
#VITE_DAEMON_KEY=
